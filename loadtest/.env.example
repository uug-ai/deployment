# Optional Docker Compose substitutions; copy to .env if needed.
# Host binds are always 127.0.0.1. Update the CLI URLs when changing these ports.
LOADTEST_MONGODB_PORT=27028
LOADTEST_RABBITMQ_PORT=5673
LOADTEST_RABBITMQ_MANAGEMENT_PORT=15673

# Pinned release defaults; use image@sha256:... for immutable repeat runs.
LOADTEST_MONGODB_IMAGE=mongo:8.0.13
LOADTEST_RABBITMQ_IMAGE=rabbitmq:4.1.4-management
LOADTEST_EVENT_IMAGE=ghcr.io/uug-ai/hub-pipeline-event:v1.3.2
LOADTEST_MONITOR_IMAGE=ghcr.io/uug-ai/hub-pipeline-monitor:v1.3.19
LOADTEST_SEQUENCE_IMAGE=ghcr.io/uug-ai/hub-pipeline-sequence:v1.7.1

# CLI host connections. Compose does not export .env into your host shell.
LOADTEST_MONGODB_URI=mongodb://127.0.0.1:27028/Kerberos?replicaSet=loadtest-rs&directConnection=true&readConcernLevel=majority&w=majority&journal=true&wtimeoutMS=10000
LOADTEST_RABBITMQ_URL=amqp://loadtest:disposable-loadtest-only@127.0.0.1:5673/
